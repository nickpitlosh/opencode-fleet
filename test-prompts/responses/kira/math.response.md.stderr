from fractions import Fraction as F
from math import comb

# 2: t^2-7t+12=0 -> discriminant 49-48=1 -> t=(7±1)/2
print('2) disc =', 49-48, '-> t =', (7+1)//2, (7-1)//2, '; check 3^2+4^2 =', 3**2+4**2, ', 3+4 =', 3+4)

# 3 numeric sanity: V=30+14*sqrt5, R=sqrt3*(1+sqrt5)/2
from math import sqrt
print('3) V = 30+14√5 ≈', 30+14*sqrt(5), ' R = √3(1+√5)/2 ≈', sqrt(3)*(1+sqrt(5))/2, ' total defect =', 20*(360-3*108),'deg =', 20*36,'= 720 = 4π rad')

# 4
fav=6*5*comb(5,3); tot=6**5
print('4) favorable =', fav, 'total =', tot, 'P =', F(fav,tot))

# 5: coefficients of ln(1+x^3): x^3 - x^6/2 + x^9/3 - x^12/4
print('5) coeffs:', [F((-1)**(k+1),k) for k in range(1,5)], 'at powers 3,6,9,12')

# 6: determinant and RREF by hand
A=[[F(1),2,3],[F(4),5,6],[F(7),8,9]]
det=A[0][0]*(A[1][1]*A[2][2]-A[1][2]*A[2][1])-A[0][1]*(A[1][0]*A[2][2]-A[1][2]*A[2][0])+A[0][2]*(A[1][0]*A[2][1]-A[1][1]*A[2][0])
print('6) det =', det)
M=[row[:] for row in A]
M[1]=[M[1][j]-4*M[0][j] for j in range(3)]
M[2]=[M[2][j]-7*M[0][j] for j in range(3)]
M[2]=[M[2][j]-2*M[1][j] for j in range(3)]
print('   row echelon:', M, '-> rank', sum(any(v!=0 for v in r) for r in M))
# null space: z free=1 -> y=-2, x=1
print('   null vector check A*(1,-2,1):', [sum(A[i][j]*[1,-2,1][j] for j in range(3)) for i in range(3)])

# 7
print('7) C(14,4) =', comb(14,4))
"
